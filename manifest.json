{
  "manifest_version": 3,
  "name": "Volume Conductor",
  "version": "1.0.0",
  "description": "Per-site volume boost that remembers your setting for every site.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["volume-store.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
